<Project xmlns="http://schemas.microsoft.com/developer/msbuild/2003">
    <PropertyGroup>
        <ProjectGuid>{826A7F60-7E04-418B-AB34-54818EF6BA44}</ProjectGuid>
    </PropertyGroup>
    <ItemGroup>
        <Projects Include="VCLSample.dproj">
            <Dependencies/>
        </Projects>
        <Projects Include="VCLSample2.dproj">
            <Dependencies/>
        </Projects>
    </ItemGroup>
    <ProjectExtensions>
        <Borland.Personality>Default.Personality.12</Borland.Personality>
        <Borland.ProjectType/>
        <BorlandProject>
            <Default.Personality/>
        </BorlandProject>
    </ProjectExtensions>
    <Target Name="VCLSample">
        <MSBuild Projects="VCLSample.dproj"/>
    </Target>
    <Target Name="VCLSample:Clean">
        <MSBuild Projects="VCLSample.dproj" Targets="Clean"/>
    </Target>
    <Target Name="VCLSample:Make">
        <MSBuild Projects="VCLSample.dproj" Targets="Make"/>
    </Target>
    <Target Name="VCLSample2">
        <MSBuild Projects="VCLSample2.dproj"/>
    </Target>
    <Target Name="VCLSample2:Clean">
        <MSBuild Projects="VCLSample2.dproj" Targets="Clean"/>
    </Target>
    <Target Name="VCLSample2:Make">
        <MSBuild Projects="VCLSample2.dproj" Targets="Make"/>
    </Target>
    <Target Name="Build">
        <CallTarget Targets="VCLSample;VCLSample2"/>
    </Target>
    <Target Name="Clean">
        <CallTarget Targets="VCLSample:Clean;VCLSample2:Clean"/>
    </Target>
    <Target Name="Make">
        <CallTarget Targets="VCLSample:Make;VCLSample2:Make"/>
    </Target>
    <Import Project="$(BDS)\Bin\CodeGear.Group.Targets" Condition="Exists('$(BDS)\Bin\CodeGear.Group.Targets')"/>
</Project>
